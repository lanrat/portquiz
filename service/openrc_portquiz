#!/sbin/openrc-run
# OpenRC service for the portquiz server, installed as /etc/init.d/portquiz.
# Settings are read from /etc/conf.d/portquiz, where PORTQUIZ_LISTEN must be set.

name="portquiz"
description="portquiz server, answers on every TCP and UDP port of its listen IPs"

# the apk package installs to /usr/bin, openrc_setup_service.sh to /usr/local/bin
if [ -n "${PORTQUIZ_BIN}" ]; then
	command="${PORTQUIZ_BIN}"
elif [ -x /usr/local/bin/portquiz-server ]; then
	command=/usr/local/bin/portquiz-server
else
	command=/usr/bin/portquiz-server
fi
command_args="-listen ${PORTQUIZ_LISTEN} ${PORTQUIZ_OPTS}"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"
# the server removes its iptables rules when it receives SIGTERM; give it time
# to do so before resorting to SIGKILL, which would leave the rules behind
retry="TERM/10/KILL/5"

depend() {
	need net
	# add the redirect rules after any saved firewall rules are restored
	after firewall
}

start_pre() {
	if [ -z "${PORTQUIZ_LISTEN}" ]; then
		eerror "PORTQUIZ_LISTEN is not set in /etc/conf.d/${RC_SVCNAME}"
		return 1
	fi
}
